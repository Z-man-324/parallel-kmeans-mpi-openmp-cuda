#!/bin/bash
#PBS -N dsa5208_bench48
#PBS -q parallel
#PBS -l select=1:ncpus=48:mpiprocs=48:mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe

set -e
cd "$PBS_O_WORKDIR"

source /app1/ebenv
module load openmpi/4.1.1

export LD_LIBRARY_PATH=/app1/centos6.3/gnu/gcc-7.3.0/lib64:/app1/centos7/gnu/openmpi-4.1.1/lib
unset LIBRARY_PATH
unset LD_PRELOAD

export OMP_DYNAMIC=FALSE
export OMP_PROC_BIND=TRUE
export OMP_PLACES=cores

mkdir -p results/benchmark_48cpu

echo "=== DSA5208 48-CPU Benchmark ==="
echo "Node: $(hostname)"
lscpu | grep 'Model name'

echo "PBS allocation:"
sort "$PBS_NODEFILE" | uniq -c

for i in 1 2 3 4 5; do
    echo "=== Repeat $i ==="

    export OMP_NUM_THREADS=1
    mpirun -np 48 --map-by slot:PE=1 --bind-to core \
        ./tests/mpi_kmeans 1000000 10 5 42 overlap \
        > "results/benchmark_48cpu/mpi_${i}.txt"

    export OMP_NUM_THREADS=3
    mpirun -np 16 --map-by slot:PE=3 --bind-to core \
        ./tests/hybrid_kmeans 1000000 10 5 42 overlap \
        > "results/benchmark_48cpu/hybrid_${i}.txt"
done

echo "=== 48-CPU Benchmark completed ==="
